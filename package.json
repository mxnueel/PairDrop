{
  "name": "qrdrop",
  "version": "1.0.0",
  "type": "module",
  "description": "Send photos and files between your phone and PC by scanning a QR code — real peer-to-peer WebRTC, nothing stored on a server. A fork of PairDrop.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/index.js --rate-limit --auto-restart",
    "test": "node --test tests/e2e.test.js"
  },
  "author": "Manuel Bautista",
  "license": "GPL-3.0",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ua-parser-js": "^1.0.37",
    "unique-names-generator": "^4.3.0",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=15"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
